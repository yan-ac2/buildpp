module;
#include "pch.hpp"

export module lib.win:keyboard;
import lib.std;
import lib.types;
import lib.utl;
import :common;

export
struct Keyboard {
    KeyState KeysState[256] {};
    const Event* event = nullptr;
    int32_t inputAccumulator = 0;
    static constexpr auto indices = std::make_index_sequence<256>{};

    constexpr Keyboard(Event* e) : event(e) {}


    constexpr bool poll(int32_t tickMS = 0, int32_t dtimeMS = 0) noexcept {
        inputAccumulator += inputAccumulator >= tickMS ? -tickMS : dtimeMS;
        if (inputAccumulator >= tickMS) {
            gatherRawInputs(indices);
            return true;
        }
        return false;
    }

    template<size_t... Is>
    inline constexpr void gatherRawInputs(std::index_sequence<Is...>) noexcept {
        BYTE windowsRawBuffer[256] = { 0 };
        if (GetKeyboardState(windowsRawBuffer)) {
            ((KeysState[Is].setRawDown(((windowsRawBuffer[Is] & 0x80) != 0)),KeysState[Is].update()), ...);
        }
    }
    
    constexpr KeyState& operator[](EventType::Key key) {
        using underlying = std::underlying_type_t<decltype(key)>;
        return KeysState[static_cast<underlying>(EventType::toPlatform(key))];
    }
    
};
