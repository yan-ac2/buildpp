module;
#include "pch.hpp"

export module lib.win:common;
import core;
import keyboard;

export class Window;

export 
class IRenderer {
public:
    virtual ~IRenderer() = default;
    virtual bool Initialize(HWND hwnd, int width, int height) = 0;
    // virtual void Resize(int width, int height) = 0;
    virtual void SwapBuffer() = 0;
    virtual bool MakeCurrent() = 0;
    virtual void Resize(int width, int height) = 0;

    // virtual void SetVsync(bool enabled) {} 
    virtual const char* GetName() {return "NULL";} 
};

export
struct MonitorConfig {
    int32 x = 0;
    int32 y = 0;
    int32 width = 0;
    int32 height = 0;
    bool isPrimary = false;
};

export 
struct WindowDesc {
    const char* title = "Application Window";
    int32 width = 800;
    int32 height = 600;
    uint32 flags = 0;
    Window* parent = nullptr; 
    Window* assigned = nullptr; 
    HINSTANCE mHInstance = nullptr;
};

export
struct EventType {
    
    enum Mouse : uint8 {
        mNull = 0,
        primary,secondary,middle,
        Xbutton1,Xbutton2,
        mLast
    };
    
    static constexpr size_t castMouse(UINT message, WPARAM wParam);
};

export
struct WindowFlags {
    enum Flags : uint32 {
        None               = 0,
        NoBorder           = 1 << 0,
        NoResize           = 1 << 1,
        AllowDND           = 1 << 2,
        HideMouse          = 1 << 3,
        Fullscreen         = 1 << 4,
        Transparent        = 1 << 5,
        WinCenter          = 1 << 6,
        RawMouse           = 1 << 7,
        ScaleToMonitor     = 1 << 8,
        Hide               = 1 << 9,
        Maximize           = 1 << 10,
        CenterCursor       = 1 << 11,
        Floating           = 1 << 12,
        FocusOnShow        = 1 << 13,
        Minimize           = 1 << 14,
        Focus              = 1 << 15,
        CaptureMouse       = 1 << 16,
        WinOGL             = 1 << 17,
        WinEGL             = 1 << 18,
        WindowedFullscreen = 1 << 19,
        CaptureRawMouse    = 1 << 20,
        WindowChild        = 1 << 21
    };

    static constexpr Vec2<uint32> WindowStyles(uint32 flags);
};

export
struct Event {
    using et =  EventType;
    keyboard::KeyState* Keys = nullptr;
    bool Mouse [et::mLast] {};
    bool onFocus = true;
    
    int32 zDelta = 0;
    int32 scrollDirection = 0;
    int32 mouseX = 0;
    int32 mouseY = 0;
    
    void addKeyboard(keyboard::KeyState* key) {Keys = key;}

    void mouseScrollevent(void(*scrFN)(int32*,int32*,void*),void* t = nullptr ){
        scrFN(&zDelta,&scrollDirection,t);
    } 
    enum event {
        eventNone = 0,
        keyPressed,
        keyReleased,
        mouseButtonPressed,
        mouseButtonReleased,
        mouseScroll, 
        mousePosChanged,
        windowMoved, 
        windowResized, 
        focusIn, 
        focusOut,
        mouseEnter,
        mouseLeave, 
        windowRefresh,
        quit, 
        dataDrop, 
        dataDrag,
        windowMaximized,
        windowMinimized,
        windowRestored,
        scaleUpdated, 
        monitorConnected,
        monitorDisconnected
    };
    
    static constexpr event parseMessage(UINT message, WPARAM wParam,[[maybe_unused]] LPARAM lParam);
};

// ____EVENT_TYPE______
#ifdef _WIN32
constexpr size_t EventType::castMouse(UINT message, WPARAM wParam) {
    switch (message) {
        // --- Left Mouse Button ---
        case WM_LBUTTONDOWN:
        case WM_LBUTTONUP:
        case WM_LBUTTONDBLCLK:
            return EventType::primary;

        // --- Right Mouse Button ---
        case WM_RBUTTONDOWN:
        case WM_RBUTTONUP:
        case WM_RBUTTONDBLCLK:
            return EventType::secondary;

        // --- Middle Mouse Button ---
        case WM_MBUTTONDOWN:
        case WM_MBUTTONUP:
        case WM_MBUTTONDBLCLK:
            return EventType::middle;

        // --- Side Buttons (XBUTTON1 / XBUTTON2) ---
        case WM_XBUTTONDOWN:
        case WM_XBUTTONUP:
        case WM_XBUTTONDBLCLK: {
            // HIWORD of wParam tells us which XButton was pressed
            WORD xbutton = HIWORD(wParam);
            if (xbutton == XBUTTON1) return EventType::Xbutton1;
            if (xbutton == XBUTTON2) return EventType::Xbutton2;
            break;
        }
    }
    return EventType::mNull;
};

constexpr Event::event Event::parseMessage(UINT message, WPARAM wParam,[[maybe_unused]] LPARAM lParam) {
    switch (message) {
        // --- Keyboard ---
        case WM_KEYDOWN:
        case WM_SYSKEYDOWN: // Captures Alt key presses too
            return keyPressed;
        case WM_KEYUP:
        case WM_SYSKEYUP:
            return keyReleased;

        // --- Mouse Buttons ---
        case WM_LBUTTONDOWN:
        case WM_RBUTTONDOWN:
        case WM_MBUTTONDOWN:
        case WM_XBUTTONDOWN:
            return mouseButtonPressed;
        case WM_LBUTTONUP:
        case WM_RBUTTONUP:
        case WM_MBUTTONUP:
        case WM_XBUTTONUP:
            return mouseButtonReleased;

        // --- Mouse Movement & Scrolling ---
        case WM_MOUSEMOVE:
            return mousePosChanged;
        case WM_MOUSEWHEEL:
        case WM_MOUSEHWHEEL:
            return mouseScroll;

        // --- Window States ---
        case WM_MOVE:
            return windowMoved;
        case WM_SIZE:
            // We determine maximization/minimization by inspecting wParam here!
            if (wParam == SIZE_MAXIMIZED) return windowMaximized;
            if (wParam == SIZE_MINIMIZED) return windowMinimized;
            if (wParam == SIZE_RESTORED)  return windowRestored; // Triggers on regular resizing too
            return windowResized;

        case WM_SETFOCUS:
            return focusIn;
        case WM_KILLFOCUS:
            return focusOut;

        case WM_MOUSEHOVER:
            return mouseEnter;
        case WM_MOUSELEAVE:
            return mouseLeave;

        case WM_PAINT:
            return windowRefresh;

        case WM_CLOSE:
        case WM_DESTROY:
        case WM_QUIT:
            return quit;

        // --- Drag & Drop ---
        case WM_DROPFILES:
            return dataDrop;

        // --- System Scales & Screens ---
        case WM_DPICHANGED:
            return scaleUpdated;

        case WM_DEVICECHANGE:
            // Check if device interface change is a display configuration change
            if (wParam == 0x0007) { // DBT_DEVNODES_CHANGED
                // Note: You'd typically compare a display count state here 
                // to determine connection vs disconnection.
                return monitorConnected; 
            }
            break;
    }
    return eventNone;
};

// ____WINDOW_FLAGS______
constexpr Vec2<uint32> WindowFlags::WindowStyles(uint32 flags) {
    uint32 outStyle = WS_OVERLAPPEDWINDOW;
    uint32 outExStyle = 0;
    if (flags == WindowFlags::None) 
    {
        return {outStyle,outExStyle};
    }
    if (flags & WindowFlags::Hide) {
        outStyle &= ~WS_VISIBLE; // Remove visible flag
    } else {
        outStyle |= WS_VISIBLE;
    }

    if (flags & WindowFlags::NoBorder) {
        // Strip out the title bar and thin/thick window borders
        outStyle &= ~(WS_CAPTION | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_SYSMENU);
        outStyle |= WS_POPUP; 
    }

    if (flags & WindowFlags::NoResize) {
        outStyle &= ~(WS_THICKFRAME | WS_MAXIMIZEBOX);
    }

    if (flags & WindowFlags::AllowDND) {
        outExStyle |= WS_EX_ACCEPTFILES;
    }

    if (flags & WindowFlags::Transparent) {
        outExStyle |= WS_EX_LAYERED;
    }

    if (flags & WindowFlags::Floating) {
        outExStyle |= WS_EX_TOPMOST;
    }

    if (flags & WindowFlags::WindowedFullscreen) {
        // Fullscreen windowed is a borderless popup that covers the entire display
        outStyle &= ~(WS_CAPTION | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_SYSMENU);
        outStyle |= WS_POPUP;
    }
    return {outStyle,outExStyle};
};
#endif