module;
#include "pch.hpp"
export module lib.win:platform;

import lib.std;
import lib.types;
import :common;
import :renderer;


export
class DisplayManager {
    public:
    DisplayManager() {
        Refresh();
        m_PreviousCount = m_Monitors.size();
    }
    ~DisplayManager() = default;

    void Refresh() {
        m_Monitors.clear();
        
        EnumDisplayMonitors(
            nullptr, 
            nullptr, 
            MonitorEnumProc, 
            reinterpret_cast<LPARAM>(this)
        );
    }

    size_t GetMonitorCount() const noexcept { return m_Monitors.size(); }
    const std::vector<MonitorConfig>& GetMonitors() const noexcept { return m_Monitors; }

    const MonitorConfig* GetPrimaryMonitor() const noexcept {
        for (const auto& monitor : m_Monitors) {
            if (monitor.isPrimary) {
                return &monitor;
            }
        }
        return m_Monitors.empty() ? nullptr : &m_Monitors[0];
    }
    // Helper checks
    bool HasTopologyChanged() {
        Refresh();
        if (m_Monitors.size() != m_PreviousCount) {
            m_PreviousCount = m_Monitors.size();
            return true;
        }
        return false;
    }
    private:
    std::vector<MonitorConfig> m_Monitors;
    size_t m_PreviousCount = 0;

    static int CALLBACK MonitorEnumProc(HMONITOR hMonitor, HDC hdcMonitor, LPRECT lprcMonitor, LPARAM dwData) {
        auto* instance = reinterpret_cast<DisplayManager*>(dwData);
        
        MONITORINFOEXA mi = {};
        mi.cbSize = sizeof(MONITORINFOEXA);
        
        if (GetMonitorInfoA(hMonitor, &mi)) {
            MonitorConfig config;
            config.x = mi.rcMonitor.left;
            config.y = mi.rcMonitor.top;
            config.width = mi.rcMonitor.right - mi.rcMonitor.left;
            config.height = mi.rcMonitor.bottom - mi.rcMonitor.top;
            config.isPrimary = (mi.dwFlags & MONITORINFOF_PRIMARY) != 0;
            
            instance->m_Monitors.push_back(config);
        }
        
        return true; // Continue enumerating
    }
};



export
class Window {
    
    std::string mClassName;
    WNDCLASSA mWCA = {};
    bool mRunning;

    inline static Window* sRootWindow = nullptr;
    public:
    WindowDesc Desc;
    HWND mHWND = nullptr;
    HDC hdc = nullptr;
    DisplayManager* mDispMgr = nullptr; 
    Event* mInput = nullptr; 
    IRenderer* gfxCtx = nullptr; 
    
    Window() = default;

    ~Window() {
        if (hdc && mHWND) ReleaseDC(mHWND, hdc);
        if (mHWND)       DestroyWindow(mHWND);
        if (!mClassName.empty()) {
            UnregisterClassA(mClassName.c_str(), Desc.mHInstance);
        }
    }

    Window(const Window&) = delete;
    Window& operator=(const Window&) = delete;
    
    Window(const char* title, int32 width, int32 height, uint32 flags, Vec2<int32> pos = {CW_USEDEFAULT, CW_USEDEFAULT}, Window* parent = nullptr) {
        Init(title,  width, height, flags, pos,parent);
    }
    void InitChild(Window* parent, const char* title, int32 width, int32 height,uint32 flags = 0, Vec2<int32> pos = {0, 0}) 
    {
        Init(title, width, height, flags, pos, parent);
    }
    [[nodiscard]] const Event& GetInput() const noexcept { return *mInput; }
    [[nodiscard]] Event&       GetInputMutable() noexcept { return *mInput; }
    [[nodiscard]] static Window&    GetRoot() { return *sRootWindow; }
    [[nodiscard]] bool IsRunning() const noexcept { return mRunning; }
    [[nodiscard]] HWND GetNativeHandle() noexcept { return mHWND; }
    
    void CloseApp() noexcept { mRunning = false; }

    void addDisplayManager(DisplayManager* disp) {
        this->mDispMgr = disp;
    }
    void addEvent(Event* iState) {
        this->mInput = iState;
    }
    void addRenderer(IRenderer* iRenderer) {
        this->gfxCtx = iRenderer;
    }

    void ProcessEvents() {
        MSG msg = {};
        mInput->scrollDirection = 0;
        
        while (PeekMessageA(&msg, nullptr, 0, 0, PM_REMOVE)) {
            auto inMsg = Event::parseMessage(msg.message,msg.wParam,msg.lParam);
            
            switch (inMsg) {
                case Event::keyPressed: {
                    // mInput.KeyInput = true;
                    break;
                };
                case Event::keyReleased: {
                    // input.keyInput = false;
                    break;
                };
                case Event::quit: {
                    mRunning = false;
                    break;
                }; 
                default:
                // std::cout << "msg : " << inMsg << "\n";
            }
            TranslateMessage(&msg);
            DispatchMessageA(&msg);
        }
    }

    LRESULT mWinProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam) {

        
        // size_t keyboard = EventType::castPlatform(wParam,lParam);
        size_t mouse = EventType::castMouse(uMsg,wParam);
        Event::parseMessage(uMsg,wParam,lParam);
        // std::print("Key: {} pressed\n",keyboard);
        // std::cout << "param : " << param << "\n";
        switch (uMsg) {
            case WM_ACTIVATE: {
                // Check the activation state
                WORD activationState = LOWORD(wParam);
                
                if (activationState == WA_INACTIVE) {
                    // Window is OUT OF FOCUS
                    std::cout << "Window lost focus (inactive)." << std::endl;
                } else {
                    // Window is IN FOCUS (WA_ACTIVE or WA_CLICKACTIVE)
                    std::cout << "Window gained focus (active)." << std::endl;
                }
            }
            break;

            case WM_DESTROY:
                PostQuitMessage(0); // Signals the message loop to stop
                return 0;
                
            // --- Mouse Movement ---
            case WM_MOUSEMOVE:
                mInput->mouseX = LOWORD(lParam); // X coordinate relative to window
                mInput->mouseY = HIWORD(lParam); // Y coordinate relative to window
            
                return 0;

            // --- Mouse Buttons ---
            case WM_LBUTTONDOWN:
                mInput->Mouse[mouse] = true;
                return 0;
            case WM_LBUTTONUP:
                mInput->Mouse[mouse] = false;
                return 0;
            case WM_RBUTTONDOWN:
                mInput->Mouse[mouse] = true;
                return 0;
            case WM_RBUTTONUP:
                mInput->Mouse[mouse] = false;
                return 0;
            case WM_XBUTTONDOWN:
                mInput->Mouse[mouse] = true;
                return 0;
            case WM_XBUTTONUP:
                mInput->Mouse[mouse] = false;
                return 0;
            case WM_MBUTTONDOWN:
                mInput->Mouse[mouse] = true;
                return 0;
            case WM_MBUTTONUP:
                mInput->Mouse[mouse] = false;
                return 0;
            // --- Mouse Wheels ---
            case WM_MOUSEWHEEL: {
                mInput->mouseScrollevent([](int32* delta,int32* sdir,void* inParam){
                    auto in = static_cast<WPARAM*>(inParam) ;
                    *delta = GET_WHEEL_DELTA_WPARAM(*in);
                    *sdir = *delta / WHEEL_DELTA;
                },&wParam);
                return 0;
            }
            
            case WM_SIZE: {
                if (gfxCtx && (Desc.flags & WindowFlags::WinOGL)) {
                    int newWidth = LOWORD(lParam);
                    int newHeight = HIWORD(lParam);
                    // Ensure our context is active on this thread before updating the viewport size
                    gfxCtx->Resize(newWidth, newHeight);
                }
                return 0;
            }
        }

        return DefWindowProcA(hwnd, uMsg, wParam, lParam);
    }
    private:
    static LRESULT CALLBACK WndProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam) {
        HDC hdc;
        Window* pWindow = nullptr;

        if (uMsg == WM_NCCREATE) {
            CREATESTRUCTA* pCreate = reinterpret_cast<CREATESTRUCTA*>(lParam);
            pWindow = reinterpret_cast<Window*>(pCreate->lpCreateParams);
            SetWindowLongPtrA(hwnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(pWindow));
        } else {
            pWindow = reinterpret_cast<Window*>(GetWindowLongPtrA(hwnd, GWLP_USERDATA));
        }
        if (pWindow) return pWindow->mWinProc(hwnd, uMsg, wParam, lParam);
        return DefWindowProcA(hwnd, uMsg, wParam, lParam);
    }

    void Init(const char* title, int32 width, int32 height, uint32 flags, Vec2<int32> pos, Window* parent) {
        Desc.mHInstance = GetModuleHandleA(nullptr);
        mClassName = "Win32Class_" + std::to_string(reinterpret_cast<uintptr_t>(this));

        auto [style, exStyle] = WindowFlags::WindowStyles(flags);
        
        mWCA.style         = CS_HREDRAW | CS_VREDRAW | CS_OWNDC;
        mWCA.lpfnWndProc   = Window::WndProc;
        mWCA.cbClsExtra    = 0;
        mWCA.cbWndExtra    = 0;
        mWCA.hInstance     = Desc.mHInstance;
        mWCA.hIcon         = LoadIcon(mWCA.hInstance, IDI_APPLICATION);
        mWCA.hCursor       = LoadCursor(nullptr, IDC_ARROW);
        mWCA.hbrBackground = nullptr; // Set background so child is visible
        mWCA.lpszMenuName  = nullptr;
        mWCA.lpszClassName = mClassName.c_str();

        RegisterClassA(&mWCA);

        HWND parentHandle = nullptr;
        if (parent != nullptr) {
            parentHandle = parent->mHWND;
            style |= WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS | WS_CLIPCHILDREN;
            style &= ~WS_POPUP;
        }
        int32 px = pos.x;
        int32 py = pos.y;
        if (flags & WindowFlags::WinCenter) {
            px = (GetSystemMetrics(SM_CXSCREEN) - width) / 2;
            py = (GetSystemMetrics(SM_CYSCREEN) - height) / 2;
        }

        // 3. Create Window with Parent HWND
        mHWND = CreateWindowExA(
            exStyle,
            mWCA.lpszClassName,
            title,
            style,
            px, py,
            width, height,
            parentHandle, // Parent HWND
            nullptr,                          // Menu/Child ID
            Desc.mHInstance,
            this
        );

        if (mHWND) {
            hdc = GetDC(mHWND);
            ShowWindow(mHWND, SW_SHOW);
            UpdateWindow(mHWND);
            mRunning = true;
        }
        Desc.title = title;
        Desc.width = width;
        Desc.height = height;
        Desc.flags = flags;
        Desc.assigned = this;
        if (!sRootWindow) sRootWindow = this;
    }
};
