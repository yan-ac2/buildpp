export
template <size_t N>
struct StaticString
{
    char data[N] {};

    constexpr StaticString(const char (&input)[N + 1])
    {
        for(size_t i {0};input[i] != '\0';i++) {
            data[i] = input[i];
        }
    }
    constexpr const size_t getSize() const {return N;}
    constexpr const char* getData () const {return data;}
    constexpr operator const char*() const {return data;}
};
template <size_t N> StaticString(const char(&)[N]) -> StaticString<N - 1>;

template <class Ty,int ID,StaticString S>
struct var {
    static constexpr std::string_view Name {S.getData(),S.getSize()};
    static constexpr int id = ID; 
    using type = Ty;
};

