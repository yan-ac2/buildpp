export
namespace Math {
    // template <typename T> concept 
    template<typename T> requires (std::integral<std::decay_t<T>> || std::floating_point<std::decay_t<T>>)
    inline consteval std::size_t maxDigits() {
        using Unqualified = std::remove_cvref_t<T>;
        if (std::integral<Unqualified>) {
            constexpr bool isSigned = std::is_signed_v<Unqualified>;
            return std::numeric_limits<Unqualified>::digits10 + 1 + (isSigned ? 1 : 0);
        } else {
            return std::numeric_limits<Unqualified>::max_exponent10 + 2;
        }
    }

    inline constexpr double PI          = 3.14159265358979323846;
    inline constexpr double TWO_PI      = 2.0 * PI;
    inline constexpr double HALF_PI     = PI / 2.0;
    inline constexpr double E           = 2.71828182845904523536;
    inline constexpr double DEG_TO_RAD  = PI / 180.0;
    inline constexpr double RAD_TO_DEG  = 180.0 / PI;

    

    template <typename T>
    constexpr T abs(T x) noexcept {
        if (std::is_constant_evaluated()) {
            return x < 0 ? -x : x;
        }
        return std::abs(x);
    }

    constexpr double fmod_two_pi(double x) noexcept {
        while (x > PI)  x -= TWO_PI;
        while (x < -PI) x += TWO_PI;
        return x;
    }
    // --- Power (Integer Exponent) ---
    template <typename T>
    constexpr T pow(T base, int exp) noexcept {
        if (std::is_constant_evaluated()) {
            T result = 1;
            bool negative = exp < 0;
            exp = negative ? -exp : exp;
            while (exp > 0) {
                if (exp % 2 == 1) result *= base;
                base *= base;
                exp /= 2;
            }
            return negative ? T(1) / result : result;
        }
        return std::pow(base, exp);
    }

    // --- Square Root (Newton-Raphson Method for Compile-Time) ---
    template <typename T>
    constexpr T sqrt(T x) noexcept {
        if (std::is_constant_evaluated()) {
            if (x < 0) return std::numeric_limits<T>::quiet_NaN();
            if (x == 0) return 0;
            
            T curr = x;
            T prev = 0;
            while (curr != prev) {
                prev = curr;
                curr = T(0.5) * (curr + x / curr);
            }
            return curr;
        }
        return std::sqrt(x);
    }

    // --- Min & Max ---
    template <typename T>
    constexpr T max(T a, T b) noexcept {
        return (a < b) ? b : a;
    }

    template <typename T>
    constexpr T min(T a, T b) noexcept {
        return (a < b) ? a : b;
    }

    // --- Clamp ---
    template <typename T>
    constexpr T clamp(T val, T low, T high) noexcept {
        return (val < low) ? low : (high < val) ? high : val;
    }

    // --- Sine ---
    constexpr double sin(double x) noexcept {
        if (std::is_constant_evaluated()) {
            while (x > TWO_PI)  x -= TWO_PI;
            while (x < 0.0)     x += TWO_PI;

            double sign = 1.0;
            if (x > PI) {
                x -= PI;
                sign = -1.0;
            }
            if (x > HALF_PI) {
                x = PI - x;
            }

            // 10 terms on [0, PI/2] provides ~10^-16 precision!
            double term = x;
            double sum = x;
            double x2 = x * x;

            for (int i = 1; i <= 10; ++i) {
                term *= -x2 / ((2 * i) * (2 * i + 1));
                sum += term;
            }
            return sign * sum;
        }
        return std::sin(x);
    }

    // --- Cosine ---
    constexpr double cos(double x) noexcept {
        if (std::is_constant_evaluated()) {
            x = fmod_two_pi(x);
            // Taylor series: 1 - x^2/2! + x^4/4! - x^6/6! + ...
            double term = 1.0;
            double sum = 1.0;
            double x2 = x * x;

            for (int i = 1; i <= 10; ++i) {
                term *= -x2 / ((2 * i - 1) * (2 * i));
                sum += term;
            }
            return sum;
        }
        return std::cos(x);
    }

    // --- Tangent ---
    constexpr double tan(double x) noexcept {
        if (std::is_constant_evaluated()) {
            double c = Math::cos(x);
            if (Math::abs(c) < 1e-15) {
                return std::numeric_limits<double>::quiet_NaN();
            }
            return Math::sin(x) / c;
        }
        return std::tan(x);
    }

    // --- Natural Exponential (e^x) ---
    constexpr double exp(double x) noexcept {
        if (std::is_constant_evaluated()) {
            // Taylor series: 1 + x + x^2/2! + x^3/3! + ...
            double term = 1.0;
            double sum = 1.0;
            for (int i = 1; i <= 250; ++i) {
                term *= x / i;
                sum += term;
            }
            return sum;
        }
        return std::exp(x);
    }

    // --- Natural Logarithm (ln(x)) ---
    constexpr double log(double x) noexcept {
        if (std::is_constant_evaluated()) {
            if (x <= 0.0) return std::numeric_limits<double>::quiet_NaN();
            
            // Halley's method iteration for fast convergence
            double y = 1.0; // Initial guess
            for (int i = 0; i < 100; ++i) {
                double ey = Math::exp(y);
                y = y + 2.0 * (x - ey) / (x + ey);
            }
            return y;
        }
        return std::log(x);
    }

    inline constexpr std::array<double, maxDigits<double>() - 1> Pow10LUT = []() consteval {
        std::array<double, maxDigits<double>() - 1> arr{};
        arr[0] = 1.0;
        for (size_t i = 1; i < arr.size(); ++i) {
            arr[i] = arr[i - 1] * 10.0;
        }
        return arr;
    }();

    inline constexpr std::array<double, 129> sinLUT512 = []() consteval {
        std::array<double, 129> arr{};
        constexpr double BRAD512_TO_RAD = (2.0 * Math::PI) / 512.0;
        
        for (size_t i = 0; i <= 128; ++i) {
            // Simple compile-time Taylor series for table initialization
            double rad = i * BRAD512_TO_RAD;
            // double term = rad, sum = rad, r2 = rad * rad;
            // for (int j = 1; j <= 10; ++j) {
            //     term *= -r2 / ((2 * j) * (2 * j + 1));
            //     sum += term;
            // }
            arr[i] = Math::sin(rad);
        }
        return arr;
    }();
    
    template <typename T> requires (std::integral<std::decay_t<T>> || std::floating_point<std::decay_t<T>>)
    inline constexpr size_t digitLength (const T& in) {
        bool isNeg = in < 0;
        // Find digit count (or highest power index) safely
        for (size_t i = 0; i < Pow10LUT.size(); ++i) {
            if ((isNeg ? -in :in) < Pow10LUT[i]) {
                return i + (isNeg ? 1 : 0);
            }
        }
        return Pow10LUT.size();
    }

    struct BradDegree {
        // 512 BRADs per circle (128 per quadrant).
        // Storing as uint16_t gives hardware-level wrapping via & 511!
        uint16_t brad;

        constexpr BradDegree() noexcept : brad(0) {}

        // Construct from degrees (e.g. BradDegree(45.0))
        constexpr explicit BradDegree(double deg) noexcept 
            : brad(static_cast<uint16_t>(static_cast<long long>(deg * (512.0 / 360.0)) & 511)) {}

        // Fast addition / subtraction (wraps automatically!)
        constexpr BradDegree operator+(BradDegree rhs) const noexcept {
            BradDegree result;
            result.brad = (brad + rhs.brad) & 511;
            return result;
        }

        constexpr BradDegree operator-(BradDegree rhs) const noexcept {
            BradDegree result;
            result.brad = (brad - rhs.brad) & 511;
            return result;
        }

        // Convert back to floating-point degrees if needed
        constexpr double toDegrees() const noexcept {
            return brad * (360.0 / 512.0);
        }
    };

    constexpr double cachedSin(BradDegree angle) noexcept {
        uint16_t idx = angle.brad; // Already wrapped in range [0, 511]

        if (idx <= 128) {
            return sinLUT512[idx];
        } else if (idx <= 256) {
            return sinLUT512[256 - idx];
        } else if (idx <= 384) {
            return -sinLUT512[idx - 256];
        } else {
            return -sinLUT512[512 - idx];
        }
    }
};
// static constexpr pow10 test;
// static constexpr double test2 = Math::sin(90.0 * Math::DEG_TO_RAD);
static_assert(Math::cachedSin(Math::BradDegree(10)) == Math::sin(10 * Math::DEG_TO_RAD)," " );
static_assert(Math::BradDegree(90).toDegrees() == 90," " );

template <typename T>
concept Formattable = 
    requires(T t) { { std::string_view(t) } -> std::same_as<std::string_view>; } || 
    std::integral<std::decay_t<T>> ||
    std::floating_point<std::decay_t<T>>;

template <typename... Args>
concept onlyStr = (Formattable<Args> && ...);

export

struct fmt {
    std::string str;

    enum colors {
        Not_color,
        Black,     Bold_Black,     High_Black,
        Red,       Bold_Red,       High_Red,
        Green,     Bold_Green,     High_Green,
        Yellow,    Bold_Yellow,    High_Yellow,
        Blue,      Bold_Blue,      High_Blue,
        Purple,    Bold_Purple,    High_Purple,
        Cyan,      Bold_Cyan,      High_Cyan,
        White,     Bold_White,     High_White,
    };

    // 1. Variadic Concatenation Constructor: fmt("hello ", 123, " world")
    template<onlyStr... Args>
    constexpr fmt(Args&&... args) {
        varConcat(std::forward<Args>(args)...);
    }
    template<onlyStr... Args>
    constexpr fmt& varConcat(Args&&... args) { 
        size_t preAlloc = (getArgSize(args) + ... + 0);
        str.reserve(preAlloc);
        (appendArg(std::forward<Args>(args)), ...);
        return *this;
    }
    // 2. Format String Constructor: fmt("Value: {}, Status: {}", 42, "OK")
    template<onlyStr... Args>
    constexpr fmt(const char* in, Args&&... args) {
        if (std::string_view(in).find('{') == std::string_view::npos) {
            varConcat(in, std::forward<Args>(args)...);
            return;
        }
        std::string_view fmtStr(in);
        size_t preAlloc = fmtStr.size() + (getArgSize(args) + ... + 0);
        formatHelper help;
        size_t lastPos = 0;

        // Lambda executed once per parameter in fold expression
        auto processArg = [this, &fmtStr, &lastPos,&help](auto&& arg) {
            size_t pBegin = fmtStr.find('{',lastPos);
            if (pBegin != std::string_view::npos) {
                size_t pEnd = fmtStr.find('}', pBegin + 1);
                if (pEnd != std::string_view::npos) {
                    str.append(fmtStr.substr(lastPos, pBegin - lastPos));
                    appendArg(std::forward<decltype(arg)>(arg), &help);
                    lastPos = pEnd + 1;
                }
            }
        };

        str.reserve(preAlloc);
        (processArg(std::forward<Args>(args)), ...);
        if (lastPos < fmtStr.size()) {
            str.append(fmtStr.substr(lastPos));
        }
    }

    // Apply ANSI Color
    constexpr fmt& color(colors c) { 
        str.reserve(str.size() + 14);
        str.insert(0, this->getColor(c));
        str.append(this->getColor(Not_color));
        return *this;
    }

    // Collapse multiple contiguous spaces into a single space
    constexpr fmt& clean() { 
        if (str.empty()) return *this;

        size_t writeIdx = 0;
        bool inSpace = false;

        for (size_t readIdx = 0; readIdx < str.size(); ++readIdx) {
            char c = str[readIdx];
            if (c == ' ') {
                if (!inSpace) {
                    str[writeIdx++] = c;
                    inSpace = true;
                }
            } else {
                str[writeIdx++] = c;
                inSpace = false;
            }
        }
        str.resize(writeIdx);
        return *this;
    }

    constexpr fmt& endl() { str.append("\n"); return *this; }

    constexpr std::string_view sv() const { return str; }
    constexpr const char* cstr() const { return str.c_str(); }
    constexpr operator std::string_view() const { return sv(); }
    constexpr operator const char*() const { return cstr(); }
    
    friend std::ostream& operator<<(std::ostream& os, const fmt& f) {
        return os << f.str;
    }

private:
    struct formatHelper {
        int attr = 0;
        int attr2 = 0;
        constexpr formatHelper() {}
    };

    template<onlyStr T>
    constexpr size_t getArgSize(const T& arg) const {
        using Raw = std::remove_cvref_t<T>;
        if constexpr (std::is_convertible_v<Raw, std::string_view>) {
            return std::string_view (arg).size();
        } else if constexpr (std::integral<Raw>) {
            return Math::digitLength(arg);
        } else if constexpr (std::floating_point<Raw>) {
            return Math::digitLength(arg);
        }
        return 0;
    }

    template<onlyStr T>
    constexpr void appendArg(T&& arg,formatHelper* help = nullptr) {
        using Raw = std::remove_cvref_t<T>;
        if constexpr (std::is_convertible_v<Raw, std::string_view>) {
            str += std::string_view(arg);
        } else if constexpr (std::integral<Raw>) {
            char digit[Math::maxDigits<Raw>()];
            auto [eDigit, ec] = std::to_chars(digit, digit + Math::maxDigits<Raw>(), std::forward<T>(arg));
            str.append(digit, static_cast<std::size_t>(eDigit - digit));
        } else if constexpr (std::floating_point<Raw>) {
            char digit[Math::maxDigits<Raw>()];
            auto [eDigit, ec] = std::to_chars(digit, digit + maxDigits<Raw>(), std::forward<T>(arg));
            str.append(digit, static_cast<std::size_t>(eDigit - digit));
        } else {
            std::unreachable();
        }
    }

    

    constexpr std::string_view getColor(colors color) const {
        switch (color) {
            case Not_color:    return "\033[0m";
            case Black:        return "\033[0;30m";
            case Red:          return "\033[0;31m";
            case Green:        return "\033[0;32m";
            case Yellow:       return "\033[0;33m";
            case Blue:         return "\033[0;34m";
            case Purple:       return "\033[0;35m";
            case Cyan:         return "\033[0;36m";
            case White:        return "\033[0;37m";
            case Bold_Black:   return "\033[1;30m";
            case Bold_Red:     return "\033[1;31m";
            case Bold_Green:   return "\033[1;32m";
            case Bold_Yellow:  return "\033[1;33m";
            case Bold_Blue:    return "\033[1;34m";
            case Bold_Purple:  return "\033[1;35m";
            case Bold_Cyan:    return "\033[1;36m";
            case Bold_White:   return "\033[1;37m";
            case High_Black:   return "\033[0;90m";
            case High_Red:     return "\033[0;91m";
            case High_Green:   return "\033[0;92m";
            case High_Yellow:  return "\033[0;93m";
            case High_Blue:    return "\033[0;94m";
            case High_Purple:  return "\033[0;95m";
            case High_Cyan:    return "\033[0;96m";
            case High_White:   return "\033[0;97m";
            default:           return "";
        }
    }
};

