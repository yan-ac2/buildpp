    operator uint8*() {return col;}
    
};

template <size_t Num>
struct vecutl {
    // void compilation_failed_invalid_swizzle_character();
    size_t num[Num];
    
    constexpr vecutl(const char (&input)[Num + 1]) : num{} {
        for (size_t i = 0; i < Num; ++i) {
            char c = input[i];

            num[i] = (c == 'x' ? 0 :
                    c == 'y' ? 1 : 
                    c == 'z' ? 2 :
                    c == 'w' ? 3 : 4);                
        }
    }
    constexpr size_t operator[](size_t i) const {
        return num[i];
    }
    // constexpr std::size_t err(int i) {
    // }
    constexpr size_t getSize() const { return Num; }
    constexpr bool max(int m) const { 
        for (const int& i : num) {
            if (i > m - 1) return false;
        }
        return true;
    }
};
template <size_t Num>
vecutl(const char(&)[Num]) -> vecutl<Num - 1>;

export
template <typename T>
class Vec2 {
    void idxErr() {
        // std::cerr << "index > 1 \n";
        std::exit(1);
    }
public:
    T x {};
    T y {};

    T& operator [](int idx) {
        switch(idx) {
            case 0: return x;
            case 1: return y;
            default: {
                idxErr();
                return x;
            }
        }
    }

    template <vecutl s> requires (s.getSize() > 1 && s.max(2))
    constexpr std::array<T, s.getSize()> swizzle() {
        std::array<T, s.getSize()> buffer;
        
        for (size_t i = 0; i < s.getSize(); ++i) {
            buffer[i] = (*this)[s.num[i]];
        }
        
        return buffer; 
    
    }
};

export
template <typename T>
class Vec3 {
    void idxErr() {
        // std::cerr << "index > 1 \n";
        std::exit(1);
    }
public:
    T x {};
    T y {};
    T z {};

    constexpr T& operator [](size_t idx) {
        switch(idx) {
            case 0: return x;
            case 1: return y;
            case 2: return z;
            default: {
                idxErr();
                return x;
            }
        }
    }

    template <vecutl s> requires (s.getSize() > 1 && s.max(3))
    constexpr std::array<T, s.getSize()> swizzle() {
        std::array<T, s.getSize()> buffer;
        
        for (size_t i = 0; i < s.getSize(); ++i) {
            buffer[i] = (*this)[s.num[i]];
        }
        return buffer;
    }
};

export
template <typename T>
class Vec4 {
    void idxErr() {
        // std::cerr << "index > 1 \n";
        std::exit(1);
    }
public:
    T x {};
    T y {};
    T z {};
    T w {};

    T& operator [](int idx) {
        switch(idx) {
            case 0: return x;
            case 1: return y;
            case 2: return z;
            case w: return z;
            default: {
                idxErr();
                return x;
            }
        }
    }

    template <vecutl s> requires (s.getSize() > 1 && s.max(4))
    constexpr std::array<T, s.getSize()> swizzle() {
        std::array<T, s.getSize()> buffer;
        
        for (size_t i = 0; i < s.getSize(); ++i) {
            buffer[i] = (*this)[s.num[i]];
        }
        return buffer;
    }
};

static_assert( []{
    Vec3<int> i {4,2,1};
    auto sw = i.swizzle<"zzz">();
    std::array<int,3> ws {1,1,1};
    return sw == ws ;
}() == true,"test");

export
class model {
    std::vector<Vec3<double>> verts = {};
    std::vector<int> faces = {};
    public: 
    model(const fs::path file) {
        static const char* vert = "v ";
        static const char* face = "f ";
        static const fs::path path = fs::current_path();
        std::ifstream in; in.open( path / file);
        if (!in) {
            // std::cerr << "failed " << path / file <<"\n"; 
            return;}
        std::string line;
        while(!in.eof()) {
            std::getline(in,line);
            std::istringstream iss(line.c_str());
            char trash;
            if (!line.compare(0,2,vert)) {
                iss >> trash;
                Vec3<double> v;
                for(int i :{0,1,2}) iss >> v[i];
                verts.push_back(v);
            } else if (!line.compare(0,2,face)) {
                int f,t,n, cnt = 0;
                iss >> trash;
                while (iss >> f >> trash >> t >> trash >> n) {
                    faces.push_back(--f);
                    cnt++;
                } 
                if (3 != cnt) {
                    // std::cerr <<  "Error: the obj file is supposed to be triangulated \n"; 
                    return;
                }
            }
        }
        // std::cerr << "# v# " << nverts() << " f# "  << nfaces() << std::endl;
    }
    int nverts() const {return verts.size();}
    int nfaces() const {return faces.size()/3;}
    Vec3<double> vert(const int i) const {return verts[i];}
    Vec3<double> vert(const int iface,const int nthvert) const {return verts[faces[iface*3+nthvert]];}
};

export
class FastBoolGenerator {
public:
    FastBoolGenerator() : m_rand(0), m_counter(0) {}

    bool next() {
        if (m_counter == 0) {
            // Fetch a new 64-bit random number
            m_rand = std::uniform_int_distribution<uint64_t>{}(m_gen);
            m_counter = 64;
        }
        // Extract the least significant bit
        bool result = (m_rand & 1);
        m_rand >>= 1; // Shift right for next call
        --m_counter;
        return result;
    }

private:
    std::mt19937 m_gen{std::random_device{}()};
    uint64_t m_rand;
    int m_counter;
};

template <size_t N>
struct bitBool {
    // 32 bytes * 8 bits = 256 bits total capacity
    unsigned char bit[N] = {0};

    // Helper proxy class to allow writing: myBits[10] = true;
    struct BitReference {
        unsigned char& byteRef;
        unsigned char mask;

        // Automatically implicitly converts to bool when reading: bool value = myBits[10];
        operator bool() const {
            return (byteRef & mask) != 0;
        }

        // Handles writing: myBits[10] = true;
        BitReference& operator=(bool value) {
            if (value) byteRef |= mask;
            else       byteRef &= ~mask;
            return *this;
        }
    };

    // Non-const operator[]: supports both reading and writing
    BitReference operator[](size_t IDX) {
        size_t bytePos = IDX / 8; // Find which of the 32 bytes holds the bit
        size_t bitPos  = IDX % 8; // Find the bit offset inside that byte
        
        unsigned char mask = static_cast<unsigned char>(1 << bitPos);
        return BitReference{ bit[bytePos], mask };
    }

    // Const operator[]: for when the bitBool instance is read-only
    bool operator[](size_t IDX) const {
        size_t bytePos = IDX / 8;
        size_t bitPos  = IDX % 8;
        return (bit[bytePos] & (1 << bitPos)) != 0;
    }
};


export
class Clock {
    using clock = std::chrono::high_resolution_clock;
    
    int32_t frame_debt= 0; 
    int32_t dt_ms     = 16;
    Clock() = default;
    
    public:
    using ms = std::chrono::milliseconds;
    clock::time_point m_start = clock::now();
    clock::time_point m_end   = clock::now();
    static Clock& get() {
        static Clock instance;
        return instance;
    }
    void start() { 
        m_start = clock::now(); 
    }
    
    int32_t end(int32_t target_ms) { 
        m_end = clock::now(); 
        auto duration = std::chrono::duration_cast<ms>(m_end - m_start);
        int32_t frame_time = static_cast<int32_t>(duration.count());

        int32_t sleep_time = (target_ms - frame_time) - frame_debt;

        if (sleep_time > 0) {
            frame_debt = 0;
            dt_ms = frame_time + sleep_time;
            return sleep_time;
        } else {
            frame_debt = static_cast<int32_t>((-sleep_time) * 0.25f);
            if (frame_debt > target_ms * 2) {
                frame_debt = target_ms * 2;
            }
            dt_ms = frame_time;
            return 0;
        }
    }

    ms end(ms target_ms) { 
        m_end = clock::now(); 
        auto duration = std::chrono::duration_cast<ms>(m_end - m_start);

        ms sleep_time = (target_ms - duration) - ms(frame_debt);

        if (sleep_time > ms(0)) {
            frame_debt = 0;
            dt_ms = duration.count() + sleep_time.count();
            return sleep_time;
        } else {
            frame_debt = static_cast<int32_t>((-sleep_time.count()) * 0.25f);
            if (frame_debt > target_ms.count() * 2) {
                frame_debt = target_ms.count() * 2;
            }
            dt_ms = duration.count();
            return ms(0);
        }
    }
    
    int32_t delta_time() const {
        return dt_ms;
    }
    
};


