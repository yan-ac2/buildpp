module;
#include "pch.hpp"
export module lib.image;
import core;
#pragma pack(push, 1)
export struct TGAHeader {
    uint8  idlength = 0;
    uint8  colormaptype = 0;
    uint8  datatypecode = 0;
    uint16 colormaporigin = 0;
    uint16 colormaplength = 0;
    uint8  colormapdepth = 0;
    uint16 x_origin = 0;
    uint16 y_origin = 0;
    uint16 width = 0;
    uint16 height = 0;
    uint8  bitsperpixel = 0;
    uint8  imagedescriptor = 0;
};
#pragma pack(pop)
export struct TGAColor {
    uint8 bgra[4] = {0,0,0,0};
    uint8 bytespp = 4;
    uint8& operator[](const int32 i) { return bgra[i]; }
    const uint8& operator[](const int32 i) const { return bgra[i]; }
};

export struct TGAImage {
    enum Format { GRAYSCALE = 1, RGB = 3, RGBA = 4 };

    TGAImage() = default;
    TGAImage(const int32 w, const int32 h, const int32 bpp, TGAColor c) : w(w), h(h), bpp(bpp), data(w*h*bpp, 0) {
        for (int32 j = 0; j < h; j++)
            for (int32 i = 0; i < w; i++)
                set(i, j, c);
    }

    bool read_tga_file(const std::string filename) {
        std::ifstream in(filename, std::ios::binary);
        if (!in.is_open()) {
            std::cerr << "can't open file " << filename << "\n";
            return false;
        }
        TGAHeader header;
        in.read(reinterpret_cast<char*>(&header), sizeof(header));
        if (!in.good()) {
            std::cerr << "an error occurred while reading the header\n";
            return false;
        }
        w   = header.width;
        h   = header.height;
        bpp = header.bitsperpixel >> 3;
        if (w <= 0 || h <= 0 || (bpp != GRAYSCALE && bpp != RGB && bpp != RGBA)) {
            std::cerr << "bad bpp (or width/height) value\n";
            return false;
        }
        size_t nbytes = static_cast<size_t>(bpp) * w * h;
        data = std::vector<uint8>(nbytes, 0);

        if (3 == header.datatypecode || 2 == header.datatypecode) {
            in.read(reinterpret_cast<int8*>(data.data()), nbytes);
            if (!in.good()) {
                std::cerr << "an error occurred while reading the data\n";
                return false;
            }
        } else if (10 == header.datatypecode || 11 == header.datatypecode) {
            if (!load_rle_data(in)) {
                std::cerr << "an error occurred while reading the data\n";
                return false;
            }
        } else {
            std::cerr << "unknown file format " << static_cast<int32>(header.datatypecode) << "\n";
            return false;
        }

        // OpenGL expects bottom-left origin (bit 5 == 0 in descriptor means bottom-left)
        // If bit 5 is set, image origin is top-left, so we flip vertically for OpenGL correctness
        if (header.imagedescriptor & 0x20)
            flip_vertically();
        if (header.imagedescriptor & 0x10)
            flip_horizontally();

        return true;
    }

    bool write_tga_file(const std::string filename, const bool vflip = true, const bool rle = true) const {
        constexpr uint8 developer_area_ref[4] = {0, 0, 0, 0};
        constexpr uint8 extension_area_ref[4] = {0, 0, 0, 0};
        constexpr uint8 footer[18] = {'T','R','U','E','V','I','S','I','O','N','-','X','F','I','L','E','.','\0'};
        std::ofstream out(filename, std::ios::binary);
        if (!out.is_open()) {
            std::cerr << "can't open file " << filename << "\n";
            return false;
        }
        TGAHeader header = {};
        header.bitsperpixel = bpp << 3;
        header.width  = w;
        header.height = h;
        header.datatypecode = (bpp == GRAYSCALE ? (rle ? 11 : 3) : (rle ? 10 : 2));
        header.imagedescriptor = vflip ? 0x00 : 0x20;
        out.write(reinterpret_cast<const int8*>(&header), sizeof(header));
        if (!out.good()) goto err;
        if (!rle) {
            out.write(reinterpret_cast<const int8*>(data.data()), w * h * bpp);
            if (!out.good()) goto err;
        } else if (!unload_rle_data(out)) goto err;
        out.write(reinterpret_cast<const int8*>(developer_area_ref), sizeof(developer_area_ref));
        if (!out.good()) goto err;
        out.write(reinterpret_cast<const int8*>(extension_area_ref), sizeof(extension_area_ref));
        if (!out.good()) goto err;
        out.write(reinterpret_cast<const int8*>(footer), sizeof(footer));
        if (!out.good()) goto err;
        return true;
    err:
        std::cerr << "can't dump the tga file\n";
        return false;
    }

    void flip_horizontally() {
        for (int32 i = 0; i < w / 2; i++)
            for (int32 j = 0; j < h; j++)
                for (int32 b = 0; b < bpp; b++)
                    std::swap(data[(i + j * w) * bpp + b], data[(w - 1 - i + j * w) * bpp + b]);
    }

    void flip_vertically() {
        for (int32 i = 0; i < w; i++)
            for (int32 j = 0; j < h / 2; j++)
                for (int32 b = 0; b < bpp; b++)
                    std::swap(data[(i + j * w) * bpp + b], data[(i + (h - 1 - j) * w) * bpp + b]);
    }

    TGAColor get(const int32 x, const int32 y) const {
        if (data.empty() || x < 0 || y < 0 || x >= w || y >= h) return {};
        TGAColor ret = {{0, 0, 0, 0}, bpp};
        const uint8 *p = data.data() + (x + y * w) * bpp;
        for (int32 i = bpp; i--; ret.bgra[i] = p[i]);
        return ret;
    }

    void set(int x, int y, const TGAColor &c) {
        if (data.empty() || x < 0 || y < 0 || x >= w || y >= h) return;
        std::memcpy(data.data() + (x + y * w) * bpp, c.bgra, bpp);
    }

    [[nodiscard]] int32 width() const { return w; }
    [[nodiscard]] int32 height() const { return h; }
    [[nodiscard]] uint8 getBpp() const { return bpp; }
    [[nodiscard]] const uint8* getData() const { return data.data(); }

    // =========================================================================
    // OpenGL Integration Helpers
    // =========================================================================

    // Maps channels to internal GL format (e.g. GL_RGB, GL_RGBA, GL_RED)
    [[nodiscard]] int32 getGLInternalFormat() const {
        switch (bpp) {
            case GRAYSCALE: return GL_RED; //0x1903; // GL_RED (or GL_LUMINANCE in legacy GL)
            case RGB:       return GL_RGB;//0x1907; // GL_RGB
            case RGBA:      return GL_RGBA;0x1908; // GL_RGBA
            default:        return 0;
        }
    }

    // Maps TGA BGR/BGRA memory channel layout to GL pixel format
    [[nodiscard]] int32 getGLFormat() const {
        switch (bpp) {
            case GRAYSCALE: return GL_RED;//0x1903; // GL_RED
            case RGB:       return GL_BGR;//0x80E0; // GL_BGR
            case RGBA:      return GL_BGRA; //0x80E1; // GL_BGRA
            default:        return 0;
        }
    }

private:
    bool load_rle_data(std::ifstream &in) {
        size_t pixelcount = static_cast<size_t>(w) * h;
        size_t currentpixel = 0;
        size_t currentbyte  = 0;
        TGAColor colorbuffer;
        do {
            uint8 chunkheader = 0;
            chunkheader = in.get();
            if (!in.good()) return false;

            if (chunkheader < 128) {
                chunkheader++;
                for (int i = 0; i < chunkheader; i++) {
                    in.read(reinterpret_cast<int8 *>(colorbuffer.bgra), bpp);
                    if (!in.good()) return false;
                    for (int t = 0; t < bpp; t++)
                        data[currentbyte++] = colorbuffer.bgra[t];
                    currentpixel++;
                }
            } else {
                chunkheader -= 127;
                in.read(reinterpret_cast<int8 *>(colorbuffer.bgra), bpp);
                if (!in.good()) return false;
                for (int i = 0; i < chunkheader; i++) {
                    for (int t = 0; t < bpp; t++)
                        data[currentbyte++] = colorbuffer.bgra[t];
                    currentpixel++;
                }
            }
        } while (currentpixel < pixelcount);
        return true;
    }

    bool unload_rle_data(std::ofstream &out) const {
        const uint8 max_chunk_length = 128;
        size_t npixels = static_cast<size_t>(w) * h;
        size_t curpix = 0;
        while (curpix < npixels) {
            size_t chunkstart = curpix * bpp;
            size_t curbyte = curpix * bpp;
            uint8 run_length = 1;
            bool raw = true;
            while (curpix + run_length < npixels && run_length < max_chunk_length) {
                bool succ_eq = true;
                for (int32 t = 0; succ_eq && t < bpp; t++)
                    succ_eq = (data[curbyte + t] == data[curbyte + t + bpp]);
                curbyte += bpp;
                if (1 == run_length)
                    raw = !succ_eq;
                if (raw && succ_eq) {
                    run_length--;
                    break;
                }
                if (!raw && !succ_eq)
                    break;
                run_length++;
            }
            curpix += run_length;
            out.put(raw ? run_length - 1 : run_length + 127);
            if (!out.good()) return false;
            out.write(reinterpret_cast<const int8 *>(data.data() + chunkstart), (raw ? run_length * bpp : bpp));
            if (!out.good()) return false;
        }
        return true;
    }

    int w = 0, h = 0;
    uint8 bpp = 0;
    std::vector<uint8> data = {};
};