export
class model {
    std::vector<Vec3<f64>> verts = {};
    std::vector<int32> faces = {};
    public: 
    model(const std::filesystem::path file) {
        static const int8* vert = "v ";
        static const int8* face = "f ";
        static const std::filesystem::path path = std::filesystem::current_path();
        std::ifstream in; in.open( path / file);
        if (!in) {
            // std::cerr << "failed " << path / file <<"\n"; 
            return;}
        std::string line;
        while(!in.eof()) {
            std::getline(in,line);
            std::istringstream iss(line.c_str());
            uint8 trash;
            if (!line.compare(0,2,vert)) {
                iss >> trash;
                Vec3<f64> v;
                for(int32 i :{0,1,2}) iss >> v[i];
                verts.push_back(v);
            } else if (!line.compare(0,2,face)) {
                int32 f,t,n, cnt = 0;
                iss >> trash;
                while (iss >> f >> trash >> t >> trash >> n) {
                    faces.push_back(--f);
                    cnt++;
                } 
                if (3 != cnt) {
                    // std::cerr <<  "Error: the obj file is supposed to be triangulated \n"; 
                    return;
                }
            }
        }
        // std::cerr << "# v# " << nverts() << " f# "  << nfaces() << std::endl;
    }
    int32 nverts() const {return verts.size();}
    int32 nfaces() const {return faces.size()/3;}
    Vec3<f64> vert(const int32 i) const {return verts[i];}
    Vec3<f64> vert(const int32 iface,const int32 nthvert) const {return verts[faces[iface*3+nthvert]];}
};

export
class FastBoolGenerator {
public:
    FastBoolGenerator() : m_rand(0), m_counter(0) {}

    bool next() {
        if (m_counter == 0) {
            // Fetch a new 64-bit random number
            m_rand = std::uniform_int_distribution<uint64>{}(m_gen);
            m_counter = 64;
        }
        // Extract the least significant bit
        bool result = (m_rand & 1);
        m_rand >>= 1; // Shift right for next call
        --m_counter;
        return result;
    }

private:
    std::mt19937 m_gen{std::random_device{}()};
    uint64_t m_rand;
    int m_counter;
};



export
class Clock {
    using clock = std::chrono::high_resolution_clock;
    
    int32 frame_debt= 0; 
    int32 dt_ms     = 16;
    Clock() = default;
    
    public:
    using ms = std::chrono::milliseconds;
    clock::time_point m_start = clock::now();
    clock::time_point m_end   = clock::now();
    static Clock& get() {
        static Clock instance;
        return instance;
    }
    void start() { 
        m_start = clock::now(); 
    }
    
    int32 end(int32 target_ms) { 
        m_end = clock::now(); 
        auto duration = std::chrono::duration_cast<ms>(m_end - m_start);
        int32 frame_time = static_cast<int32>(duration.count());

        int32 sleep_time = (target_ms - frame_time) - frame_debt;

        if (sleep_time > 0) {
            frame_debt = 0;
            dt_ms = frame_time + sleep_time;
            return sleep_time;
        } else {
            frame_debt = static_cast<int32>((-sleep_time) * 0.25f);
            if (frame_debt > target_ms * 2) {
                frame_debt = target_ms * 2;
            }
            dt_ms = frame_time;
            return 0;
        }
    }

    ms end(ms target_ms) { 
        m_end = clock::now(); 
        auto duration = std::chrono::duration_cast<ms>(m_end - m_start);

        ms sleep_time = (target_ms - duration) - ms(frame_debt);

        if (sleep_time > ms(0)) {
            frame_debt = 0;
            dt_ms = duration.count() + sleep_time.count();
            return sleep_time;
        } else {
            frame_debt = static_cast<int32>((-sleep_time.count()) * 0.25f);
            if (frame_debt > target_ms.count() * 2) {
                frame_debt = target_ms.count() * 2;
            }
            dt_ms = duration.count();
            return ms(0);
        }
    }
    
    int32 delta_time() const {
        return dt_ms;
    }
    
};