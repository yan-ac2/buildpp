module;
#include "pch.hpp"
#include <cstddef>
#include <span>
export module lib.ui;
import lib.std;
import lib.types;
import lib.win;

export
struct Rect {
    Vec2<float> pos;
    Vec2<float> size;

    constexpr bool contains(Vec2<float> pt) const noexcept {
        return pt.x >= pos.x && pt.x <= (pos.x + size.x) &&
                pt.y >= pos.y && pt.y <= (pos.y + size.y);
    }
};

export
struct ui_ctx {
    Vec2<float> pos;
    Vec2<float> uv;
    Vec4<uint8> color;
};

export
struct GLDrawCmd {
    uint32_t element_count = 0; // Number of indices/vertices
    uint32_t index_offset  = 0; // Offset in index buffer
    uint32_t vertex_offset = 0; // Offset in vertex buffer
    uint64_t texture_id    = 0; // Texture handle (0 = white texture for flat rects)
};

export
struct InputState {
    Vec2<float> mouse_pos{0.0f, 0.0f};
    bool mouse_down{false};
    bool mouse_clicked{false}; // Single frame trigger
};

enum class CommandType { DrawRect, DrawText };

export
struct DrawCommand {
    CommandType type;
    Rect bounds;
    Vec4<uint8> color;
};

export
class GLUIRenderer {
    GLuint vao = 0;
    GLuint vbo = 0;
    GLuint ebo = 0;
    GLuint shader_program = 0;
    GLuint white_texture = 0;
    
    size_t vbo_capacity = 0;
    size_t ebo_capacity = 0;

    const char* vert = R"(#version 430 core
        layout (location = 0) in vec2 aPos;
        layout (location = 1) in vec2 aUV;
        layout (location = 2) in vec4 aColor;

        out vec2 FragUV;
        out vec4 FragColor;

        uniform vec2 uScreenSize; // Pass (width, height)

        void main() {
        FragUV = aUV;
        FragColor = aColor;

        // Convert screen coordinates [0, Width] x [0, Height] to NDC [-1, 1]
        // Top-Left origin (0,0) -> Bottom-Right (Width, Height)
        vec2 ndcPos = (aPos / uScreenSize) * 2.0 - 1.0;
        gl_Position = vec4(ndcPos.x, -ndcPos.y, 0.0, 1.0); // Flip Y axis
    })";
    const char* frag = R"(#version 430 core
    in vec2 FragUV;
    in vec4 FragColor;

    out vec4 FinalColor;

    uniform sampler2D uTexture;

    void main() {
        FinalColor = texture(uTexture, FragUV) * FragColor;
    })";
public:
    std::vector<ui_ctx> vertices;
    std::vector<uint32_t> indices;
    std::vector<GLDrawCmd> commands;

    void init() {
        // 1. Create VAO, VBO, EBO
        glGenVertexArrays(1, &vao);
        glGenBuffers(1, &vbo);
        glGenBuffers(1, &ebo);

        glBindVertexArray(vao);
        glBindBuffer(GL_ARRAY_BUFFER, vbo);
        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, ebo);

        // Vertex Attributes (Pos, UV, Color)
        // Position (2 floats)
        glEnableVertexAttribArray(0);
        glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, sizeof(ui_ctx), 
                              (void*)offsetof(ui_ctx, pos));

        // UVs (2 floats)
        glEnableVertexAttribArray(1);
        glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, sizeof(ui_ctx), 
                              (void*)offsetof(ui_ctx, uv));

        // Color (4 Normalized Unsigned Bytes -> RGBA float in shader)
        glEnableVertexAttribArray(2);
        glVertexAttribPointer(2, 4, GL_UNSIGNED_BYTE, GL_TRUE, sizeof(ui_ctx), 
                              (void*)offsetof(ui_ctx, color));

        glBindVertexArray(0);

        // 2. Create a dummy 1x1 white texture for flat rendering
        glGenTextures(1, &white_texture);
        glBindTexture(GL_TEXTURE_2D, white_texture);
        uint32_t white_pixel = 0xFFFFFFFF;
        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, &white_pixel);

        
        int success;
        char infoLog[512];
        GLuint sfrag = 0;
        GLuint svert = 0;
        sfrag = glCreateShader(GL_FRAGMENT_SHADER);
        glShaderSource(sfrag,1,&frag,nullptr);
        glCompileShader(sfrag);
        glGetShaderiv(sfrag, GL_COMPILE_STATUS, &success);
        if (!success) {
            glGetShaderInfoLog(sfrag, 512, nullptr, infoLog);
            std::cout << infoLog << "\n";
        }
        svert = glCreateShader(GL_VERTEX_SHADER);
        glShaderSource(svert,1,&vert,nullptr);
        glCompileShader(svert);
        glGetShaderiv(svert, GL_COMPILE_STATUS, &success);
        if (!success) {
            glGetShaderInfoLog(svert, 512, nullptr, infoLog);
            std::cout << infoLog << "\n";
        }


        
        
        
        shader_program = glCreateProgram();
        for (auto& s : {sfrag,svert}){
            glAttachShader(shader_program, s);
        }

        glLinkProgram(shader_program);
        glGetProgramiv(shader_program, GL_LINK_STATUS, &success);
        if (!success) {
            glGetProgramInfoLog(shader_program, 512, nullptr, infoLog);
            std::cout << infoLog << "\n";
        }
        
        for (auto& s : {sfrag,svert}) {
            glDeleteShader(s);
        }   
    }

    void clear() {
        vertices.clear();
        indices.clear();
        commands.clear();
    }

    void render(const RenderBuffer& buffer, float viewport_width, float viewport_height) {
        if (buffer.vertices.empty() || buffer.commands.empty()) return;

        // 1. Setup GL State
        glEnable(GL_BLEND);
        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        glDisable(GL_DEPTH_TEST);
        glDisable(GL_CULL_FACE);

        glUseProgram(shader_program);

        // Update screen size uniform for top-left NDC coordinate conversion
        GLint screen_size_loc = glGetUniformLocation(shader_program, "uScreenSize");
        glUniform2f(screen_size_loc, viewport_width, viewport_height);

        glBindVertexArray(vao);

        // 2. Upload Dynamic Vertex/Index Buffers
        glBindBuffer(GL_ARRAY_BUFFER, vbo);
        size_t needed_vbo_size = buffer.vertices.size() * sizeof(ui_ctx);
        if (needed_vbo_size > vbo_capacity) {
            vbo_capacity = needed_vbo_size * 2; // Allocate extra space to reduce reallocation frequency
            glBufferData(GL_ARRAY_BUFFER, vbo_capacity, nullptr, GL_DYNAMIC_DRAW);
        }
        glBufferSubData(GL_ARRAY_BUFFER, 0, needed_vbo_size, buffer.vertices.data());

        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, ebo);
        size_t needed_ebo_size = buffer.indices.size() * sizeof(uint32_t);
        if (needed_ebo_size > ebo_capacity) {
            ebo_capacity = needed_ebo_size * 2;
            glBufferData(GL_ELEMENT_ARRAY_BUFFER, ebo_capacity, nullptr, GL_DYNAMIC_DRAW);
        }
        glBufferSubData(GL_ELEMENT_ARRAY_BUFFER, 0, needed_ebo_size, buffer.indices.data());

        // 3. Dispatch Draw Batches
        for (const auto& cmd : buffer.commands) {
            GLuint tex = (cmd.texture_id == 0) ? white_texture : static_cast<GLuint>(cmd.texture_id);
            
            glActiveTexture(GL_TEXTURE0);
            glBindTexture(GL_TEXTURE_2D, tex);

            glDrawElementsBaseVertex(
                GL_TRIANGLES,
                cmd.element_count,
                GL_UNSIGNED_INT,
                reinterpret_cast<void*>(cmd.index_offset * sizeof(uint32_t)),
                cmd.vertex_offset
            );
        }

        glBindVertexArray(0);
    }

    // Add a flat-colored rectangle
    void push_rect(Vec2<float> pos, Vec2<float> size,Vec4<uint8_t> color, uint64_t texture_id = 0) {
        // Check if we can batch into the previous draw command
        if (commands.empty() || commands.back().texture_id != texture_id) {
            GLDrawCmd cmd{};
            cmd.element_count = 0;
            cmd.index_offset = static_cast<uint32_t>(indices.size());
            cmd.vertex_offset = static_cast<uint32_t>(vertices.size());
            cmd.texture_id = texture_id;
            commands.push_back(cmd);
        }

        const uint32_t base_index = static_cast<uint32_t>(vertices.size());

        // 4 Corner Vertices
        vertices.push_back({{pos.x,            pos.y},     {0.0f, 0.0f}, color}); // Top-Left
        vertices.push_back({{pos.x + size.x,   pos.y},     {1.0f, 0.0f}, color }); // Top-Right
        vertices.push_back({{pos.x + size.x,   pos.y + size.y},{1.0f, 1.0f}, color }); // Bottom-Right
        vertices.push_back({{pos.x,            pos.y + size.y},{0.0f, 1.0f}, color }); // Bottom-Left

        // 6 Indices (2 Triangles forming 1 Quad)
        indices.push_back(base_index + 0);
        indices.push_back(base_index + 1);
        indices.push_back(base_index + 2);

        indices.push_back(base_index + 2);
        indices.push_back(base_index + 3);
        indices.push_back(base_index + 0);

        commands.back().element_count += 6;
    }
};

export
class Context {
    std::variant<glRenderBuffer> backend;
public:
    InputState input;
    Style default_style;
    std::vector<DrawCommand> draw_list;
    uint64_t hovered_id = 0;
    uint64_t active_id  = 0;

    void begin_frame(InputState current_input) {
        input = current_input;
        draw_list.clear();
        hovered_id = 0;
    }

};

export 
bool button(Context& ctx, uint64_t id, const Rect& bounds) {
    bool result = false;

    // 1. Hit Testing
    bool is_hovered = bounds.contains(ctx.input.mouse_pos);

    if (is_hovered) {
        ctx.hovered_id = id;
        if (ctx.input.mouse_clicked) {
            ctx.active_id = id;
        }
    }

    // 2. Logic & Click Detection
    if (ctx.active_id == id && !ctx.input.mouse_down) {
        if (is_hovered) {
            result = true; // Button was clicked!
        }
        ctx.active_id = 0; // Release active state
    }

    // 3. Resolve Styling State
    Vec4<uint8_t> current_color = ctx.default_style.bg_color;
    if (ctx.active_id == id) {
        current_color = ctx.default_style.active_color;
    } else if (is_hovered) {
        current_color = ctx.default_style.hover_color;
    }

    // 4. Submit Draw Call
    ctx.draw_list.push_back(DrawCommand{
        .type = CommandType::DrawRect,
        .bounds = bounds,
        .color = current_color
    });

    return result;
}
